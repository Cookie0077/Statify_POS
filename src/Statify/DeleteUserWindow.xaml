<Window x:Class="Statify.DeleteUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Statify"
        mc:Ignorable="d"
        Title="Delete Account"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1f1d3a">

    <Border CornerRadius="14"
            BorderBrush="{StaticResource HeroAccentBrush}"
            BorderThickness="1"
            ClipToBounds="True">
        <StackPanel>

            <!-- Header -->
            <Border Background="{StaticResource HeroAccentBrush}"
                    CornerRadius="14 14 0 0" Padding="20 12">
                <TextBlock Text="Delete Account"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource LightTextBrush}" />
            </Border>

            <!-- Message -->
            <TextBlock Text="Are you sure you want to delete this account? This action cannot be undone."
                       FontSize="13"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Margin="24 20 24 20" />

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="24 0 24 24">
                <Button x:Name="ButtonCancel"
                        Content="Cancel"
                        Width="90" Height="60"
                        Margin="0 0 10 0"
                        Click="ButtonCancel_OnClick"
                        Background="Transparent"
                        Foreground="{StaticResource LightTextBrush}"
                        BorderBrush="{StaticResource MutedTextBrush}"
                        BorderThickness="1"
                        Cursor="Hand" />
                <Button x:Name="ButtonDelete"
                        Content="Delete"
                        Width="90" Height="60"
                        Click="ButtonDelete_OnClick"
                        Background="#c0392b"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand" />
            </StackPanel>

        </StackPanel>
    </Border>

</Window>