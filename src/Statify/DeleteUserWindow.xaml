<Window x:Class="Statify.DeleteUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Statify"
        mc:Ignorable="d"
        Title="Delete Account"
        Height="220" Width="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#1f1d3a"
            CornerRadius="14"
            BorderBrush="{StaticResource HeroAccentBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource HeroAccentBrush}"
                    CornerRadius="14 14 0 0" Padding="20 12">
                <TextBlock Text="Delete Account"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource LightTextBrush}" />
            </Border>

            <!-- Message -->
            <TextBlock Grid.Row="1"
                       Text="Are you sure you want to delete this account? This action cannot be undone."
                       FontSize="13"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="24 16" />

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="24 0 24 20">
                <Button x:Name="ButtonCancel"
                        Content="Cancel"
                        Width="90" Height="34"
                        Margin="0 0 10 0"
                        Click="ButtonCancel_OnClick"
                        Background="Transparent"
                        Foreground="{StaticResource LightTextBrush}"
                        BorderBrush="{StaticResource MutedTextBrush}"
                        BorderThickness="1"
                        Cursor="Hand" />
                <Button x:Name="ButtonDelete"
                        Content="Delete"
                        Width="90" Height="34"
                        Click ="ButtonDelete_OnClick"
                        Background="#c0392b"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand" />
            </StackPanel>

        </Grid>
    </Border>

</Window>