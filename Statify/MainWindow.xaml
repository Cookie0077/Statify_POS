<Window x:Class="Statify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Statify"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="6*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="1" Grid.Column="0"  >

            <ListView DockPanel.Dock="Left"  Width="200" Padding="10" Margin=" 20 50"  ItemsSource="{Binding Topartists}" />
            <!--<In die Mitte soll ein Dashboard -->
            <ListView DockPanel.Dock="Right" Width="150" Margin="20 50" Padding="10" HorizontalAlignment="Right" ItemsSource="{Binding TopTracks}" />
        </DockPanel>

        <DockPanel Grid.Row="0" >
            <TabControl SelectionChanged="TabControl_SelectionChanged" Padding="10" >
                <TabItem Header="Home" x:Name="TabHome" Height="35"  Width="150"/>
                <TabItem Header="Artists" x:Name="ArtistTab" Width="100"  />
                <TabItem Header="Songs" x:Name="SongTabs"  Width="100" />
                <TabItem Header="Playlists" x:Name="PlaylistTab"  Width="100" />
            </TabControl>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="50 0 0 0"  >
                <Image  Width="50" Height="50" Margin="10 0"/>
                <Label Content="Username" x:Name="Labelusername" Height="35" Padding="10" VerticalContentAlignment="Center" Margin="20 0" />
                <Button x:Name="ButtonUserSettings" Content="Settings" Padding="10" Margin="20 0"/>

            </StackPanel>


        </DockPanel>

       


    </Grid>
</Window>
