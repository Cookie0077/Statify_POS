<Window x:Class="Statify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Statify"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          
        </Grid.RowDefinitions>

    
        <DockPanel Grid.Row="0">
            <TabControl x:Name="MainTabControl" 
                        SelectionChanged="TabControl_SelectionChanged"
                        >
                <TabItem Header="Home"      x:Name="TabHome"   Height="50"    Width="150"/>
                <TabItem Header="Artists"   x:Name="ArtistTab"           Width="100"/>
                <TabItem Header="Songs"     x:Name="SongTabs"            Width="100"/>
                <TabItem Header="Playlists" x:Name="PlaylistTab"         Width="100"/>
            </TabControl>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        VerticalAlignment="Top" Margin="50 0 0 0">
                <Image Width="50" Height="50" Margin="10 0"/>
                <Label Content="Username" x:Name="Labelusername"
                       Height="35" Padding="10" VerticalContentAlignment="Center" Margin="20 0"/>
                <Button x:Name="ButtonUserSettings" Content="Settings"
                        Padding="10" Margin="20 0"/>
            </StackPanel>
        </DockPanel>

      
        <Frame x:Name="Mainframe" Grid.Row="1"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>