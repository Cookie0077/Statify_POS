<Window x:Class="Statify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Statify"
        mc:Ignorable="d"
        Title="MainWindow" WindowState="Maximized" MinWidth="400" MinHeight="300" WindowStyle="None">

    <Viewbox Stretch="Uniform">
        <Grid Width="1600" Height="900">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <TabControl x:Name="MainTabControl" Background="Transparent" SelectionChanged="TabControl_SelectionChanged">
                    <TabItem Header="Home" x:Name="TabHome" Height="80" Width="250" FontSize="22"/>
                    <TabItem Header="Artists" x:Name="ArtistTab" Height="80" Width="200" FontSize="22"/>
                    <TabItem Header="Songs" x:Name="SongTabs" Height="80" Width="200" FontSize="22"/>
                    <TabItem Header="Playlists" x:Name="PlaylistTab" Height="80" Width="200" FontSize="22"/>
                </TabControl>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="50 0 0 0">
                    <Label Content="Username" x:Name="Labelusername" Height="80" Padding="20" FontSize="22" VerticalContentAlignment="Center" Margin="20 0"/>
                    <Button x:Name="ButtonUserSettings" Content="Settings" Padding="20 10" FontSize="22" Margin="20 0"/>
                    <Button x:Name="ButtonClose" Content="✕" Width="46" Height="46" FontSize="18" Margin="20 0 10 0" Padding="0" Background="Transparent" BorderThickness="0" Foreground="Gray" VerticalAlignment="Center" Click="ButtonClose_Click"/>
                </StackPanel>

            </DockPanel>


            <Frame x:Name="Mainframe" Grid.Row="1" NavigationUIVisibility="Hidden"/>

        </Grid>
    </Viewbox>

</Window>