<Page x:Class="Statify.PlaylistPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Statify"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="1600"
      Title="PlaylistPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <local:SpotfyItemView Grid.Column="0" x:Name="PlaylistView" Margin="10"></local:SpotfyItemView>

        <Frame Grid.Column="1" x:Name="PlaylistPageFrame" ></Frame>
    </Grid>

</Page>