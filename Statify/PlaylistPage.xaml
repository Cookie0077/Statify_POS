<Page x:Class="Statify.PlaylistPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Statify"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="1600"
      Title="PlaylistPage"
      Background="Transparent">

    <Grid Margin="32 24 32 24">
        <Grid x:Name="ContentGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="6 0 6 18">
                <TextBlock Text="LIBRARY" Style="{StaticResource EyebrowTextStyle}" />
                <TextBlock Text="Playlists" Style="{StaticResource HeadlineTextStyle}" Margin="0 4 0 4" />
                <TextBlock Text="Pick a playlist to see its tracks side-by-side."
                           Style="{StaticResource MutedTextStyle}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Your Playlists"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0 0 0 12" />
                        <local:SpotfyItemView x:Name="PlaylistView" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Playlist Detail"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0 0 0 12" />
                        <Frame x:Name="PlaylistPageFrame"
                               NavigationUIVisibility="Hidden"
                               Background="Transparent" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
        <local:LoadingOverlay x:Name="LoadingOverlay"/>
    </Grid>
</Page>