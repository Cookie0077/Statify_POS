<Page x:Class="Statify.PlaylistDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Statify"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PlaylistDetailPage"
      Background="Transparent">

    <Border Style="{StaticResource CardStyle}" Margin="6">
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Titel + Button oben -->
            <Grid Grid.Row="0">
                <TextBlock Text="Tracks"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0 0 0 12"
                           HorizontalAlignment="Left"/>

                <Button Content="View on Spotify"
                        Name="ButtonViewOnSpotify"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Right"
                        MinWidth="220"
                        Height="56"
                        Click="ButtonViewOnSpotify_Click"/>
            </Grid>

            <local:SpotfyItemView x:Name="TrackView"
                                  Grid.Row="1"/>

        </Grid>
    </Border>
</Page>