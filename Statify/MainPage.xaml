<Page x:Class="Statify.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Statify"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <DockPanel Background="AliceBlue" >

        <ListView DockPanel.Dock="Left"  Width="200" Padding="10" Margin=" 20 50"  ItemsSource="{Binding Topartists}" />
        <!--<In die Mitte soll ein Dashboard -->
        <ListView DockPanel.Dock="Right" Width="150" Margin="20 50" Padding="10" HorizontalAlignment="Right" ItemsSource="{Binding TopTracks}" />
    </DockPanel>
</Page>
