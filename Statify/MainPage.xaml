<Page x:Class="Statify.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Statify"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <DockPanel Background="AliceBlue">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="10" DockPanel.Dock="Left">
            <Label Content="Top Artists" HorizontalAlignment="Center" FontSize="24" Background="Azure" Margin="5"></Label>
            <local:SpotfyItemView x:Name="SpotfyItemViewTopArtists" Width="250"></local:SpotfyItemView>
        </StackPanel>

        <StackPanel x:Name="StackPanelTopTracks" DockPanel.Dock="Right" Orientation="Vertical" Margin="10" Width="330" Background="Transparent">
            <Label Content="Top Tracks" HorizontalAlignment="Center" FontSize="24" Margin="5" Background="Azure" ></Label>
            <local:SpotfyItemView x:Name="SpotfyItemViewTopTracks" Width="350"></local:SpotfyItemView>
        </StackPanel>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Width="150" Height="350" VerticalAlignment="Center" Margin="30 0 0 0">
            <Label Content="Dashboards" FontSize="24" Background="Azure"></Label>
            <lvc:PieChart Background="Transparent" x:Name="TrackChart" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="20" Width="150" Height="100" FontSize="2"/>

        </StackPanel>
       
    </DockPanel>
</Page>