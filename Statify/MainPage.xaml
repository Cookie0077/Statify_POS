<Page x:Class="Statify.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Statify"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <DockPanel Background="AliceBlue">
      
        <local:SpotfyItemView x:Name="SpotfyItemViewTopArtists" DockPanel.Dock="Left" Margin="0 10" Width="250"></local:SpotfyItemView>
        <StackPanel x:Name="StackPanelTopTracks" DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
            <local:SpotfyItemView x:Name="SpotfyItemViewTopTracks"></local:SpotfyItemView>
        </StackPanel>

        <lvc:PieChart Background="Transparent" x:Name="TrackChart" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="20" Width="150" Height="150"/>

    </DockPanel>
</Page>