<Page x:Class="Statify.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Statify"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="1600"
      Title="MainPage">

    <DockPanel Background="AliceBlue">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="20" DockPanel.Dock="Left">
            <Label Content="Top Artists" HorizontalAlignment="Center" FontSize="36" Background="Azure" Margin="10"/>
            <local:SpotfyItemView x:Name="SpotfyItemViewTopArtists" Width="450"/>
        </StackPanel>

        <StackPanel x:Name="StackPanelTopTracks" DockPanel.Dock="Right" Orientation="Vertical" Margin="20" Width="550" Background="Transparent">
            <Label Content="Top Tracks" HorizontalAlignment="Center" FontSize="36" Margin="10" Background="Transparent"/>
            <local:SpotfyItemView x:Name="SpotfyItemViewTopTracks" Width="520"/>
        </StackPanel>

        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Width="400" VerticalAlignment="Top" Margin="40 30 0 0">
            <Label Content="Dashboards" FontSize="36" Background="Azure" HorizontalAlignment="Center" Margin="10"/>
            <lvc:PieChart x:Name="TrackChart" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="20" Width="350" Height="350" FontSize="14"/>
        </StackPanel>
    </DockPanel>

</Page>