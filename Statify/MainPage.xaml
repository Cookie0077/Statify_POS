<Page x:Class="Statify.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Statify"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <DockPanel Background="AliceBlue">

        <ListView DockPanel.Dock="Left"
                  Width="Auto" MinWidth="150" MaxWidth="250"
                  Padding="10" Margin="20 50"
                  ItemsSource="{Binding Topartists}" />

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
            <!--> Temporäre Lösung muss, da zu wenig UI erfahrung <!-->
            <ListView HorizontalAlignment="Right" Padding="10" ItemsSource="{Binding Track_Images}" Margin="0 50" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            <ListView Margin="0 50 5 50" MinWidth="150" MaxWidth="220" Padding="10" HorizontalAlignment="Right" ItemsSource="{Binding TopTracks}" />
        </StackPanel>

        <lvc:PieChart x:Name="TrackChart" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="20"/>

    </DockPanel>
</Page>