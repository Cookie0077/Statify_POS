<Window x:Class="Statify.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Statify"
        mc:Ignorable="d"
        Title="RegisterWindow" Height="450" Width="800">
    <DockPanel>
        <Label Content="Welcome to Statify" HorizontalAlignment="Center" DockPanel.Dock="Top" FontSize="40" Margin="10"/>
        <StackPanel Orientation="Vertical"  HorizontalAlignment="Center" VerticalAlignment="Center"  Width="200" Height="300">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Width="150" >
                <Label Content="Username:" VerticalAlignment="Center" Margin="5" Padding="4" />
                <TextBox x:Name="TextBoxName"  Margin="10" Padding="5" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Width="150">
                <Label Content="Password:" VerticalAlignment="Center" Margin="5"  Padding="4" HorizontalAlignment="Center" />
                <PasswordBox x:Name="PasswordBoxPW"  Margin="10" Padding="5" HorizontalAlignment="Center"  />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Width="150" >
                <Label Content="Reenter Password:" VerticalAlignment="Center" Margin="5"  Padding="4"/>
                <PasswordBox x:Name="PasswordBoxPWRE"  Margin="10" Padding="5" HorizontalAlignment="Center" />
            </StackPanel>
            <Button x:Name="ButtonRegister" Content="Register" Margin="10" Padding="5" Width="100" Click="ButtonRegister_Click" />
        </StackPanel>
    </DockPanel>

</Window>
