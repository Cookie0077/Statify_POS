<Window x:Class="Statify.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Statify"
        mc:Ignorable="d"
        Title="LoginWindow" WindowState="Maximized" MinWidth="400" MinHeight="300" WindowStyle="None">

    <Viewbox Stretch="Uniform">
        <DockPanel Width="1600" Height="900">
            <Label Content="Welcome Back" HorizontalAlignment="Center" DockPanel.Dock="Top" FontSize="80" Margin="20"/>

            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Width="500" Height="450">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Width="450">
                    <Label Content="Username:" VerticalAlignment="Center" Margin="10" Padding="8" FontSize="22" Width="180"/>
                    <TextBox x:Name="TextBoxName" Margin="10" Padding="10" FontSize="22" Width="220" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Width="450">
                    <Label Content="Password:" VerticalAlignment="Center" Margin="10" Padding="8" FontSize="22" Width="180"/>
                    <PasswordBox x:Name="PasswordBoxPW" Margin="10" Padding="10" FontSize="22" Width="220" HorizontalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="ButtonLogin" IsDefault="True" Content="Login" Margin="20 20 20 10" Padding="12 8" FontSize="24" Width="200" Click="ButtonLogin_Click"/>
                <Button x:Name="ButtonRegister" Content="New Account" Margin="20 10 20 20" Padding="12 8" FontSize="24" Width="200" Click="ButtonRegister_Click"/>

            </StackPanel>
        </DockPanel>
    </Viewbox>

</Window>