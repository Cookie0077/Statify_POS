<Window x:Class="Statify.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Statify"
        mc:Ignorable="d"
        Title="LoginWindow" Height="400" Width="500">
    <DockPanel>
        <Label Content="Welcome Back" HorizontalAlignment="Center" DockPanel.Dock="Top" FontSize="40" Margin="10"/>
        <StackPanel Orientation="Vertical"  HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Height="300">
            <TextBox x:Name="TextBoxName" Text="Enter Username" Margin="10" Padding="5" HorizontalAlignment="Center" />
            <TextBox x:Name="TextBoxPassword" Text="Enter Password" Margin="10" Padding="5" HorizontalAlignment="Center" />
            <Button x:Name="ButtonLogin" Content="Login" Margin="10" Padding="5" Width="100" Click="ButtonLogin_Click" />
            <Button x:Name="ButtonRegister" Content="New Account" Margin="10" Padding="5" Width="100" />
        </StackPanel>
    </DockPanel>

</Window>
